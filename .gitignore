# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Dependencies (none today, but keeps future tooling out of the repo)
node_modules/

# Local env / secrets — never commit service-role keys
.env
.env.*
!.env.example

# Build output
dist/

# Local-only content snapshot for offline builds. Production fetches live.
content.fixture.json

# City photo working dirs — originals + resized output live in Supabase, not git.
# The resize script (scripts/) is tracked; the images it reads/writes are not.
city-photos-src/
city-photos-out/
